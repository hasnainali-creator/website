---
import type { CollectionEntry } from "astro:content";
import { formatDate, getDateDistance, normalizeDate } from "@/lib/utils/date";
import ResourcesAdd from "@/components/common/icons/resources-add.astro";
import Time04 from "@/components/common/icons/time-04.astro";
import Calendar04 from "@/components/common/icons/calendar-04.astro";
import Divider from "@/components/bases/divider.astro";
import {
  categoriesHandler,
  normalizeCategoryData,
} from "@/lib/handlers/categories";
import { authorsHandler } from "@/lib/handlers/authors";
import Share from "@/components/elements/share.astro";

import Breadcrumbs from "@/components/elements/breadcrumbs.astro";

type Props = {
  article: CollectionEntry<"articles">;
};

const { article } = Astro.props;

// Zenith High-Performance Execution: Manual AVIF Generation for Universal Speed
import { getImage } from "astro:assets";
const q = 85; // High-Fidelity Zenith: Flawless AVIF quality for 2K/FHD delivery

const hasCover = !!article.data.cover;

const img400 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 400,
      quality: q,
    })
  : null;
const img665 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 665,
      quality: q,
    })
  : null;
const img800 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 800,
      quality: q,
    })
  : null;
const img1024 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 1024,
      quality: q,
    })
  : null;
const img1920 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 1920,
      quality: q,
    })
  : null;
const img2560 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 2560,
      quality: q,
    })
  : null;

const lcpSrcset = hasCover
  ? `${img400?.src} 400w, ${img665?.src} 665w, ${img800?.src} 800w, ${img1024?.src} 1024w, ${img1920?.src} 1920w, ${img2560?.src} 2560w`
  : "";

const authors = await authorsHandler.getAuthors(article.data.authors);
const catProvider = await categoriesHandler.getProvider();
const cats = normalizeCategoryData(article.data.category);
const category = catProvider.oneCategory(
  cats[0]?.discriminant || "uncategorized",
);

const breadcrumbs = [
  {
    label: category.data.title || "Category",
    url: `/categories/${category.id}/1`,
  },
  { label: article.data.title || "Article", url: `/articles/${article.id}` },
];
import { Picture } from "astro:assets";
---

<section
  class="mb-8 flex flex-col lg:flex-col-reverse border-b border-b-base-300 lg:border-none pb-4 pt-0 lg:pt-6"
>
  <div
    class="container px-0 max-w-5xl lg:mt-4 overflow-hidden aspect-[20/9] lg:rounded-md bg-base-200"
  >
    {
      hasCover && img800 && (
        <img
          src={img800.src}
          srcset={lcpSrcset}
          alt={
            article.data.coverAlt ||
            article.data.title ||
            "OmnySports Article Cover"
          }
          sizes="(max-width: 1024px) 100vw, 1024px"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="w-full h-full object-cover"
          width="1024"
          height="460"
        />
      )
    }
  </div>
  <div class="container my-4 max-w-5xl lg:hidden flex items-center gap-2">
    <ResourcesAdd size="16" />
    {
      cats[0]?.discriminant && (
        <a
          href={`/categories/${cats[0].discriminant}/1`}
          class="a-01 font-medium text-[#0A8BF3] dark:text-secondary"
        >
          {catProvider.getDisplayPath(cats[0].discriminant)}
        </a>
      )
    }
  </div>
  <div class="container max-w-5xl">
    <Breadcrumbs crumbs={breadcrumbs} />
    <h1
      class="article-headline text-3xl lg:text-4xl font-bold text-left text-pretty mt-1 lg:mt-2"
    >
      {article.data.title}
    </h1>
    <div class="flex flex-col gap-4 items-start mt-2 lg:mt-6 text-sm">
      <div class="text-base-content/70 flex items-center gap-2">
        <span class="hidden lg:flex items-center gap-1">
          <ResourcesAdd size="15" />
          <a
            href={`/categories/${category.id}/1`}
            class="a-01 font-medium text-[#0A8BF3] dark:text-secondary"
            >{category.data.title}</a
          >
        </span>
        <Divider responsive />
        <span class="flex items-center gap-1">
          <Calendar04 size="15" />
          <time
            class="hidden lg:block"
            datetime={normalizeDate(article.data.publishedTime)}
            >{
              formatDate(normalizeDate(article.data.publishedTime), "long")
            }</time
          >
          <time
            class="block lg:hidden"
            datetime={normalizeDate(article.data.publishedTime)}
            >{
              formatDate(normalizeDate(article.data.publishedTime), "short")
            }</time
          >
        </span>
        <Divider />
        <span class="flex items-center gap-1">
          <Time04 size="15" />
          <time
            datetime={normalizeDate(article.data.publishedTime)}
            data-relative
          >
            {getDateDistance(normalizeDate(article.data.publishedTime))}
          </time>
        </span>
      </div>
      <!-- TODO: fix name, href, avatar of author -->
      <div class="w-full flex flex-wrap gap-2 items-center justify-between">
        <div class="flex flex-wrap gap-4">
          {
            authors.map((author) => (
              <div class="flex items-center gap-2">
                <a
                  href={`/authors/${author.id}`}
                  class="flex items-center gap-2"
                >
                  <div class="avatar">
                    <div class="w-8 rounded-full">
                      {author.data.avatar ? (
                        <Picture
                          src={author.data.avatar}
                          formats={["avif", "webp"]}
                          widths={[96, 192, 384]}
                          alt={author.data.name || "Author Avatar"}
                          sizes="32px"
                          loading={"eager"}
                          fetchpriority="high"
                          decoding="sync"
                          class="rounded-full object-cover border border-base-content/10"
                          quality={100}
                        />
                      ) : (
                        <div class="w-8 h-8 bg-base-300 flex items-center justify-center rounded-full">
                          <span class="text-xs font-bold uppercase">
                            {(author.data.name || "?").charAt(0)}
                          </span>
                        </div>
                      )}
                    </div>
                  </div>
                  <span class="font-bold capitalize">{author.data.name}</span>
                </a>
              </div>
            ))
          }
        </div>
        <Share text={article.data.title || ""} />
      </div>
    </div>
  </div>
</section>
