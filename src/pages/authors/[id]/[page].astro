---
export const prerender = true;
import type { GetStaticPaths } from "astro";
import { SITE } from "@/lib/config";
import { articlesHandler } from "@/lib/handlers/articles";
import { authorsHandler } from "@/lib/handlers/authors";
import WideCard from "@/components/cards/wideCard.astro";
import Pagination from "@/components/shared/pagination.astro";
import { getEntry } from "astro:content";
import { getMeta } from "@/lib/utils/getMeta";
import BaseLayout from "@/layouts/base.astro";
import Breadcrumbs from "@/components/elements/breadcrumbs.astro";
import { Picture } from "astro:assets";

export const getStaticPaths = (async ({ paginate }) => {
  const allAuthors = await authorsHandler.allAuthors();
  const allArticles = await articlesHandler.allArticles();

  return allAuthors.flatMap((author) => {
    const filteredArticles = allArticles.filter((article) =>
      article.data.authors.map((a) => a.id).includes(author.id),
    );
    return paginate(filteredArticles, {
      params: { id: author.id },
      pageSize: SITE.postsPerPage,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const params = Astro.params;
const articles = page.data;
const pathname = new URL(Astro.request.url).pathname.split("/");
const basePath = `${pathname[1]}/${pathname[2]}`;

const entry = await getEntry("views", "author");
const author = await authorsHandler.findAuthor(params.id!);

if (!entry) {
  return Astro.redirect("/404");
}

const meta = await getMeta(entry);
meta.title = `${author.data.name}'s Profile - ${SITE.title}`;
meta.breadcrumbs = [
  { label: author.data.name, url: `/authors/${author.id}/1` },
];
meta.prev = page.url.prev;
meta.next = page.url.next;

const schema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: author.data.name,
  jobTitle: author.data.job,
  description: author.data.bio,
  image: author.data.avatar
    ? new URL(author.data.avatar.src, Astro.url).href
    : undefined,
  worksFor: {
    "@type": "NewsMediaOrganization",
    name: SITE.title,
    url: Astro.site ? Astro.site.origin : "https://omnysports.pages.dev",
  },
  url: Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : Astro.url.href,
};
---

<BaseLayout
  entry={{
    ...entry,
    data: {
      ...entry.data,
      title: `${author.data.name}'s ${entry.data.title}`,
    },
  }}
  meta={meta}
>
  <!-- Zenith Authority: Injecting High-Performance Identity Schema -->
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema)}
  />

  <div
    class="container flex flex-col h-full pb-8 pt-4"
    data-pagefind-ignore="all"
  >
    <!-- Premium Author Hub Header -->
    <div class="flex flex-col mb-8 pt-4">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        {
          author.data.avatar ? (
            <div class="relative w-24 h-24 md:w-32 md:h-32">
              <Picture
                src={author.data.avatar as any}
                formats={["avif", "webp"]}
                widths={[128, 256, 512]}
                alt={`Official Portrait of ${author.data.name}`}
                sizes="(max-width: 768px) 96px, 128px"
                loading="eager"
                fetchpriority="high"
                class="w-full h-full rounded-2xl object-cover shadow-xl border-2 border-base-content/5"
                quality={100}
              />
            </div>
          ) : (
            <div class="w-24 h-24 md:w-32 md:h-32 rounded-2xl bg-base-300 flex items-center justify-center border-2 border-base-content/5 flex-shrink-0 shadow-xl">
              <span class="text-4xl text-base-content/50 uppercase font-bold">
                {(author.data.name || "?").charAt(0)}
              </span>
            </div>
          )
        }
        <div class="flex-1">
          <div class="flex flex-wrap items-center gap-3">
            <h1
              class="text-3xl md:text-4xl font-extrabold font-sans m-0 leading-tight tracking-tight"
              style="font-weight: 800;"
            >
              {author.data.name}
            </h1>
          </div>
          <p
            class="text-sm md:text-base text-primary font-bold uppercase tracking-widest mt-2 opacity-80"
          >
            {author.data.job}
          </p>
          {
            author.data.bio && (
              <p class="text-lg text-base-content/70 mt-4 leading-relaxed max-w-2xl font-medium">
                {author.data.bio}
              </p>
            )
          }
        </div>
      </div>
    </div>

    <hr class="border-t border-base-content/10 mb-8 w-full" />

    <div class="mb-8">
      <h2
        class="text-2xl md:text-3xl font-extrabold font-sans mb-4 tracking-tight"
        style="font-weight: 800;"
      >
        Recent Work by {author.data.name}
      </h2>
      <Breadcrumbs crumbs={meta.breadcrumbs} />
    </div>

    <section class="flex-1">
      <ul class="flex flex-col gap-4">
        {
          articles.map((article) => (
            <WideCard
              article={article}
              isLast={articles.lastIndexOf(article) === articles.length - 1}
            />
          ))
        }
      </ul>
    </section>

    <Pagination
      length={page.lastPage}
      currentUrl={page.url.current}
      currentPage={page.currentPage}
      baseUrl={`/${basePath}`}
      prevUrl={page.url.prev}
      nextUrl={page.url.next}
      lastUrl={`/${basePath}/${page.lastPage}`}
    />
  </div>
</BaseLayout>
