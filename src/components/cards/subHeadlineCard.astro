---
import type { CollectionEntry } from "astro:content";
import { getImage } from "astro:assets";
import Divider from "../bases/divider.astro";
import { getDateDistance, normalizeDate } from "@/lib/utils/date";
import {
  categoriesHandler,
  normalizeCategoryData,
} from "@/lib/handlers/categories";
const catProvider = await categoriesHandler.getProvider();

type Props = {
  article: CollectionEntry<"articles">;
  isFirst?: boolean;
  isLast?: boolean;
};
const { article, isLast, isFirst } = Astro.props;

const q = 75; // Zenith Density: Perfect clarity for sub-headlines
const hasCover = !!article.data.cover;

const img200 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 200,
      quality: q,
    })
  : null;
const img400 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 400,
      quality: q,
    })
  : null;
const lcpSrcset = hasCover ? `${img200?.src} 200w, ${img400?.src} 400w` : "";
---

<article
  class:list={[
    "group py-2 flex items-stretch gap-2 group relative isolate",
    isFirst ? "pt-0" : "pt-2",
    isLast ? "border-b-0 pb-0" : "border-b border-base-300",
  ]}
  style="content-visibility: auto; contain-intrinsic-size: 100% 120px;"
>
  <div class="flex flex-col flex-1">
    <div class="flex items-center gap-2 mb-1">
      <div class="flex-1">
        <h3
          class="text-[18px] font-semibold leading-tight tracking-tight lg:group-hover:underline underline-offset-2 line-clamp-2 text-pretty"
        >
          <a href={`/articles/${article.id}`}>
            <span class="absolute inset-0 z-10"></span>
            {article.data.title}
          </a>
        </h3>
        <p
          class="text-[13.3px] text-base-content/75 text-balance md:line-clamp-2 lg:line-clamp-3 leading-snug"
        >
          {article.data.description}
        </p>
      </div>
    </div>
    <div
      class="flex items-center text-[12.7px] text-base-content/70 mt-1 lg:mt-auto"
    >
      <p class="font-medium text-[#0A8BF3] dark:text-secondary capitalize">
        {
          catProvider.getDisplayPath(
            normalizeCategoryData(article.data.category)[0]?.discriminant ||
              "uncategorized",
          )
        }
      </p>
      <Divider />
      <time datetime={normalizeDate(article.data.publishedTime)} data-relative>
        {getDateDistance(normalizeDate(article.data.publishedTime))}
      </time>
    </div>
  </div>

  <div
    class="overflow-hidden w-[100px] sm:w-[130px] md:w-[165px] h-auto shrink-0 relative bg-base-300 rounded"
    style="aspect-ratio: 4 / 3;"
  >
    {
      hasCover && img200 && (
        <img
          src={img200.src}
          srcset={lcpSrcset}
          alt={
            article.data.coverAlt || article.data.title || "Sub Headline News"
          }
          sizes="(max-width: 768px) 165px, 120px"
          loading="lazy"
          fetchpriority="auto"
          decoding="async"
          class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"
          width="200"
          height="150"
        />
      )
    }
  </div>
</article>
