---
import type { CollectionEntry } from "astro:content";
import Divider from "@/components/bases/divider.astro";
import {
  categoriesHandler,
  normalizeCategoryData,
} from "@/lib/handlers/categories";
import { getDateDistance, normalizeDate } from "@/lib/utils/date";
import { getImage } from "astro:assets";

const catProvider = await categoriesHandler.getProvider();

type Props = {
  article: CollectionEntry<"articles">;
};

const { article } = Astro.props;

// Zenith High-Performance Execution: Manual AVIF Generation for Universal Speed
const q = 35; // Surgical alignment with head.astro for 100% cache hit
const hasCover = !!article.data.cover;

const img400 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 400,
      quality: q,
    })
  : null;
const img800 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 800,
      quality: q,
    })
  : null;
const img1200 = hasCover
  ? await getImage({
      src: article.data.cover!,
      format: "avif",
      width: 1200,
      quality: q,
    })
  : null;
const lcpSrcset = hasCover
  ? `${img400?.src} 400w, ${img800?.src} 800w, ${img1200?.src} 1200w`
  : "";
---

<article class="group relative isolate flex flex-col-reverse md:flex-col gap-4">
  <div
    class="overflow-hidden rounded-md relative bg-base-300"
    style="aspect-ratio: 16 / 9; width: 100%;"
  >
    {
      hasCover && img800 && (
        <img
          src={img800.src}
          srcset={lcpSrcset}
          alt={
            article.data.coverAlt || article.data.title || "Main Headline News"
          }
          sizes="(max-width: 768px) calc(100vw - 32px), 800px"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          width="800"
          height="450"
        />
      )
    }
  </div>
  <div class="flex flex-col gap-2">
    <div>
      <h2
        class="text-[18px] font-semibold leading-tight tracking-tight lg:group-hover:underline underline-offset-2"
      >
        <a href={`/articles/${article.id}`}>
          <span class="absolute inset-0 z-10"></span>
          {article.data.title}
        </a>
      </h2>
      <p class="text-base-content/80 text-[13.3px] leading-snug max-w-lg">
        {article.data.description}
      </p>
    </div>
    <div class="flex items-center text-[12.7px] text-base-content/70 mt-2">
      <span class="font-medium text-[#0A8BF3] dark:text-secondary"
        >{
          catProvider.getDisplayPath(
            normalizeCategoryData(article.data.category)[0]?.discriminant ||
              "uncategorized",
          )
        }</span
      >
      <Divider />
      <time datetime={normalizeDate(article.data.publishedTime)} data-relative>
        {getDateDistance(normalizeDate(article.data.publishedTime))}
      </time>
    </div>
  </div>
</article>
