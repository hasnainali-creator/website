---
import Github from "@/components/common/icons/github.astro";
import NewTwitter from "@/components/common/icons/new-twitter.astro";
import Telegram from "@/components/common/icons/telegram.astro";
import Facebook from "@/components/common/icons/facebook.astro";

export interface Props {
  icon: string | undefined;
}

const { icon } = Astro.props;

if (!icon) {
  throw new Error("Icon prop is required");
}
---

{icon === "github" && <Github />}
{icon === "telegram" && <Telegram />}
{icon === "newTwitter" && <NewTwitter />}
{icon === "facebook" && <Facebook />}
