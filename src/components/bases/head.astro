---
import { SITE } from "@/lib/config";
import type { ArticleMeta, Meta } from "@/lib/types";

type Props = {
  meta: Meta | ArticleMeta;
  preloadImage?: string | any;
  preloadSizes?: string;
};

const { meta, preloadImage, preloadSizes = "100vw" } = Astro.props;

import { categoriesHandler } from "@/lib/handlers/categories";
const catProvider = await categoriesHandler.getProvider();
const navCategories = catProvider.getNestedCategories();
const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;

// Zenith: High-Fidelity Universal Speed Path
import { getImage } from "astro:assets";
const isArticleMeta = (meta: any): meta is ArticleMeta =>
  meta.type === "article";
const OGImage = new URL(meta.ogImage, Astro.url).href;

let preloadSrcset = "";

if (preloadImage) {
  if (typeof preloadImage === "object") {
    const q = 35; // Surgical balance for sub-1s mobile LCP
    const img400 = await getImage({
      src: preloadImage,
      format: "avif",
      width: 400,
      quality: q,
    });
    const img800 = await getImage({
      src: preloadImage,
      format: "avif",
      width: 800,
      quality: q,
    });
    const img1200 = await getImage({
      src: preloadImage,
      format: "avif",
      width: 1200,
      quality: q,
    });
    preloadSrcset = `${img400.src} 400w, ${img800.src} 800w, ${img1200.src} 1200w`;
  } else {
    preloadSrcset = `${preloadImage} 400w, ${preloadImage} 800w, ${preloadImage} 1200w`;
  }
} else if (isArticleMeta(meta)) {
  preloadSrcset = `${OGImage} 400w, ${OGImage} 800w, ${OGImage} 1200w`;
}

const schemaOrg: any = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${Astro.site}#website`,
      url: Astro.site,
      name: SITE.title,
      description: SITE.description,
      publisher: {
        "@id": `${Astro.site}#organization`,
      },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${SITE.url}/search?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "NewsMediaOrganization",
      "@id": `${Astro.site}#organization`,
      name: SITE.title,
      url: Astro.site,
      logo: {
        "@type": "ImageObject",
        "@id": `${Astro.site}#logo`,
        url: new URL("favicon-96x96.png", Astro.site).href,
        contentUrl: new URL("favicon-96x96.png", Astro.site).href,
        width: 96,
        height: 96,
        caption: SITE.title,
      },
      image: {
        "@id": `${Astro.site}#logo`,
      },
      sameAs: [
        "https://instagram.com/omnysports",
        "https://twitter.com/omnysports",
        "https://facebook.com/omnysports",
        "https://tiktok.com/@omnysports",
      ],
      contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer service",
        url: new URL("contact", Astro.site).href,
        email: "contact@omnysports.com",
      },
      verified: "true",
      foundingDate: "2024",
      ethicsPolicy: "https://omnysports.pages.dev/editorial-policy",
      correctionsPolicy: "https://omnysports.pages.dev/contact",
    },
  ],
};

if (isArticleMeta(meta)) {
  schemaOrg["@graph"].push({
    "@type": "NewsArticle",
    "@id": `${canonicalURL}#article`,
    isPartOf: {
      "@id": `${Astro.site}#website`,
    },
    headline: meta.metaTitle || meta.title || "News Article",
    datePublished: new Date(meta.publishedTime || Date.now()).toISOString(),
    dateModified: new Date(
      meta.lastModified || meta.publishedTime || Date.now(),
    ).toISOString(),
    description: meta.description || SITE.description,
    copyrightYear: new Date(meta.publishedTime || Date.now()).getFullYear(),
    isAccessibleForFree: "True",
    articleSection: meta.category?.[0] || "Sports News",
    mainEntityOfPage: {
      "@id": canonicalURL,
    },
    primaryImageOfPage: { "@id": `${canonicalURL}#image` },
    image: {
      "@type": "ImageObject",
      "@id": `${canonicalURL}#image`,
      url: OGImage,
      width: 1200,
      height: 630,
      caption: meta.metaTitle || meta.title || SITE.title,
    },
    author: (meta.authors && meta.authors.length > 0
      ? meta.authors
      : [{ name: SITE.author, link: "admin" }]
    ).map((author) => ({
      "@type": "Person",
      name: author.name,
      jobTitle: author.jobTitle || "Journalist",
      description:
        author.description ||
        `${author.name} is a professional contributor to ${SITE.title}.`,
      url: new URL(`authors/${author.link}`, Astro.site).href,
    })),
    publisher: {
      "@type": "Organization",
      name: SITE.title,
      logo: {
        "@type": "ImageObject",
        url: new URL("favicon-96x96.png", Astro.site).href,
      },
    },
    inLanguage: SITE.locale,
    wordCount: meta.description?.length
      ? Math.ceil(meta.description.length / 5)
      : 100,
    about: meta.keywords
      ? meta.keywords.split(",").map((kw: string) => ({
          "@type": "Thing",
          name: kw.trim(),
          sameAs: meta.wikidataId
            ? `https://www.wikidata.org/wiki/${meta.wikidataId}`
            : undefined,
        }))
      : undefined,
    contentLocation: meta.itemLocation
      ? {
          "@type": "Place",
          name: meta.itemLocation,
        }
      : undefined,
    abstract: meta.description,
    articleBody: (meta as any).articleBody || meta.description,
    speakable: {
      "@type": "SpeakableSpecification",
      cssSelector: [".article-headline", ".article-content"],
    },
  });
}

// SiteNavigationElement for rich sitelinks
schemaOrg["@graph"].push({
  "@type": "ItemList",
  "@id": `${Astro.site}#primary-navigation`,
  name: "Primary Navigation",
  itemListElement: [
    {
      "@type": "SiteNavigationElement",
      position: 1,
      name: "Home",
      url: Astro.site,
    },
    ...navCategories.map((cat, index) => ({
      "@type": "SiteNavigationElement",
      position: index + 2,
      name: cat.data.title || cat.id,
      url: new URL(`categories/${cat.id}/1`, Astro.site).href,
    })),
  ],
});

const schemaOrgString = JSON.stringify(schemaOrg);

const breadcrumbSchema: any = meta.breadcrumbs
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: Astro.site,
        },
        ...meta.breadcrumbs.map((crumb, index) => ({
          "@type": "ListItem",
          position: index + 2,
          name: crumb.label || "Page",
          item: new URL(crumb.url, Astro.site).href,
        })),
      ],
    }
  : null;

const breadcrumbSchemaString = breadcrumbSchema
  ? JSON.stringify(breadcrumbSchema)
  : null;
---

<head>
  <meta charset={SITE.charset} />
  <meta name="viewport" content="width=device-width,initial-scale=1" />

  {/* Level 0 Alpha: DNS & Preconnect Optimization */}
  <link rel="preconnect" href="https://omnysports.pages.dev" crossorigin />
  <link rel="dns-prefetch" href="https://omnysports.pages.dev" />

  {
    /* Priority #1 (LCP Monopolization Target): Image gets highest native network priority */
  }
  {
    preloadSrcset && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={preloadSrcset}
        imagesizes={preloadSizes}
        fetchpriority="high"
      />
    )
  }

  {
    /* Priority #2 (FCP / Visual Completion Sync): All fonts fetch parallel but deprioritized to preserve LCP bandwidth */
  }
  <link
    rel="preload"
    href="/fonts/inter-latin-wght-normal.woff2"
    as="font"
    type="font/woff2"
    fetchpriority="low"
    crossorigin="anonymous"
  />

  {/* Universal Light Mode Enforcement */}
  <!-- Global Metadata -->
  <meta name="generator" content={Astro.generator} />

  <!-- Font Architecture: Rendering enforcement -->
  <style is:inline>
    @font-face {
      font-family: "Inter";
      font-style: normal;
      font-display: swap;
      font-weight: 100 900;
      src: url("/fonts/inter-latin-wght-normal.woff2")
        format("woff2-variations");
      size-adjust: 107%;
      ascent-override: 90%;
      descent-override: 22%;
      line-gap-override: 0%;
    }
  </style>

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Page Metadata -->
  <title>{meta.title}</title>
  <meta name="title" content={meta.metaTitle} />
  <meta name="description" content={meta.description} />
  {meta.keywords && <meta name="keywords" content={meta.keywords} />}

  <!-- Essential SEO Robots for Google News -->
  <!-- TOTAL SEO SHIELDING: Purging Dummy Content from Google -->
  {
    SITE.SHIELD_MODE ? (
      <meta name="robots" content="noindex, nofollow, noarchive" />
    ) : (
      <>
        <meta
          name="robots"
          content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
        />
      </>
    )
  }

  <!-- 1. Master Brand Logo (Consolidated System) -->
  <!-- SVG renders crisp at any size — no pixelation -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
  <!-- PNG fallback for older browsers + Apple -->
  <link
    rel="icon"
    type="image/png"
    sizes="96x96"
    href="/omnysports-logo.png?v=3"
  />
  <link
    rel="apple-touch-icon"
    sizes="180x180"
    href="/omnysports-logo.png?v=3"
  />
  <meta name="apple-mobile-web-app-title" content={SITE.title} />
  <meta name="application-name" content={SITE.title} />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- RSS & Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link
    rel="sitemap"
    type="application/xml"
    title="News Sitemap"
    href="/sitemap-news.xml"
  />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={SITE.title}
    href={new URL("rss.xml", Astro.site)}
  />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={meta.type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={meta.metaTitle} />
  <meta property="og:description" content={meta.description} />
  <meta property="og:image" content={OGImage} />
  <meta property="og:image:alt" content={meta.ogImageAlt} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content={SITE.title} />
  <meta property="og:locale" content={SITE.locale} />

  <!-- Twitter -->
  <meta property="twitter:site" content="@OmnySports" />
  <meta property="twitter:creator" content="@OmnySports" />
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={meta.metaTitle} />
  <meta property="twitter:description" content={meta.description} />
  <meta property="twitter:image" content={OGImage} />
  <meta property="twitter:image:alt" content={meta.ogImageAlt} />

  {
    isArticleMeta(meta) ? (
      <>
        <meta
          property="article:published_time"
          content={new Date(meta.publishedTime).toISOString()}
        />
        <meta
          property="article:modified_time"
          content={new Date(meta.lastModified).toISOString()}
        />
        {(meta as any).category?.[0] && (
          <meta
            property="article:section"
            content={(meta as any).category[0]}
          />
        )}
        {meta.keywords &&
          meta.keywords
            .split(",")
            .map((tag) => <meta property="article:tag" content={tag.trim()} />)}

        {meta.authors.map((author) => (
          <>
            <meta property="author" content={author.name} />
            <meta
              property="article:author"
              content={`${Astro.site}authors/${author.link}`}
            />
          </>
        ))}
      </>
    ) : null
  }

  {/* Technical SEO: Pagination Relations */}
  {meta.prev && <link rel="prev" href={new URL(meta.prev, Astro.site).href} />}
  {meta.next && <link rel="next" href={new URL(meta.next, Astro.site).href} />}

  <script is:inline type="application/ld+json" set:html={schemaOrgString} />
  {
    breadcrumbSchemaString && (
      <script
        is:inline
        type="application/ld+json"
        set:html={breadcrumbSchemaString}
      />
    )
  }

  {/* Speculation Rules API: 'Hard Intelligence' Zero-Latency Pre-rendering */}
  {
    /* This pre-renders internal links during hover/intent for 0ms transitions */
  }
  <script type="speculationrules" is:inline>
    {
      "prerender": [
        {
          "source": "list",
          "urls": ["/", "/articles", "/categories"]
        },
        {
          "where": {
            "and": [
              { "href_matches": "/*" },
              { "not": { "href_matches": ["/admin/*", "/keystatic/*"] } }
            ]
          },
          "eagerness": "immediate"
        }
      ]
    }
  </script>

  <!-- Speculation Rules: Predictive Loading -->
</head>
